<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>VillageIntel</AssemblyName>
    <RootNamespace>VillageIntel</RootNamespace>
    <Version>1.0.0</Version>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>

    <!-- Change this if Bannerlord is installed somewhere else, or pass /p:GameFolder="..." -->
    <GameFolder Condition="'$(GameFolder)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Mount &amp; Blade II Bannerlord</GameFolder>
    <ModuleName>VillageIntel</ModuleName>
    <ModuleBin>$(GameFolder)\Modules\$(ModuleName)\bin\Win64_Shipping_Client</ModuleBin>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets `dotnet build` target .NET Framework 4.7.2 without the VS targeting pack installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.*.dll"
               Exclude="$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.Native.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\SandBox\bin\Win64_Shipping_Client\SandBox.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\Bannerlord.MBOptionScreen\bin\Win64_Shipping_Client\MCMv5.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- After building, install the module straight into the game's Modules folder. -->
  <Target Name="InstallModule" AfterTargets="Build">
    <MakeDir Directories="$(ModuleBin)" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll;$(TargetDir)$(AssemblyName).pdb" DestinationFolder="$(ModuleBin)" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Copy SourceFiles="..\Module\SubModule.xml" DestinationFolder="$(GameFolder)\Modules\$(ModuleName)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <ModuleDataFiles Include="..\Module\ModuleData\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModuleDataFiles)" DestinationFiles="@(ModuleDataFiles->'$(GameFolder)\Modules\$(ModuleName)\ModuleData\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
